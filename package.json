{
  "name": "@iobroker/aggregate",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared data aggregation for the ioBroker history, sql and influxdb adapters",
  "author": "bluefox <dogafox@gmail.com>",
  "contributors": [
    "bluefox <dogafox@gmail.com>",
    "Apollon77"
  ],
  "homepage": "https://github.com/ioBroker/aggregate",
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/aggregate"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/aggregate/issues"
  },
  "keywords": [
    "ioBroker",
    "history",
    "aggregate",
    "statistics",
    "log data",
    "home automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./aggregate": {
      "types": "./build/aggregate.d.ts",
      "default": "./build/aggregate.js"
    },
    "./time": {
      "types": "./build/time.d.ts",
      "default": "./build/time.js"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "default": "./build/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@iobroker/types": "^7.2.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "c8": "^12.0.0",
    "mocha": "^11.8.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:package": "echo \"no tests for package\"",
    "test:integration": "mocha --config test/.mocharc.json \"test/**/*.test.ts\"",
    "prebuild": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs",
    "test": "mocha --config test/.mocharc.json \"test/**/*.test.ts\"",
    "test:coverage": "c8 npm test",
    "check": "npm run lint && npm run check:ts && npm test",
    "prepublishOnly": "npm run build",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade"
  }
}
